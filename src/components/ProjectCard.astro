---
import type { Project } from '../data/projects';
import { useTranslations, type Lang } from '../i18n/utils';
import Seal from './Seal.astro';
import ArchitectureDiagram from './ArchitectureDiagram.astro';

interface Props {
  project: Project;
  lang: Lang;
  offset?: 'up' | 'down' | 'none';
}
const { project, lang, offset = 'none' } = Astro.props;
const t = useTranslations(lang);

const offsetClass =
  offset === 'up' ? 'lg:-translate-y-6' : offset === 'down' ? 'lg:translate-y-6' : '';

const detailHref = lang === 'fr' ? `/ouvrages/${project.slug}/` : `/en/work/${project.slug}/`;
---

<article
  class:list={['project-card reveal-item-fade group shrink-0', offsetClass]}
  style="width: min(82vw, 400px);"
  data-slug={project.slug}
>
  <div class="card-wrap relative" style="perspective: 1600px;">
    <div
      class="card-inner relative aspect-[3/4.3] w-full"
      style="transform-style: preserve-3d;"
    >
      <!-- FRONT -->
      <div
        class="card-face paper-grain absolute inset-0 flex flex-col rounded-lg border border-line-strong bg-cream-card p-6 shadow-[6px_6px_0_0_var(--color-line-strong)]"
        style="backface-visibility: hidden;"
        data-face="front"
      >
        <div class="flex items-start justify-between">
          <span class="font-mono text-[11px] uppercase tracking-widest text-ink-soft">{project.year}</span>
          <span class="font-mono text-[11px] uppercase tracking-widest text-terracotta-deep">{project.tag[lang]}</span>
        </div>

        <div class="my-6 h-28 w-28 self-center text-terracotta/70">
          {project.visibility === 'client' ? (
            <ArchitectureDiagram n={project.diagram as 1 | 2 | 3} />
          ) : (
            <Seal n={project.seal as 1 | 2 | 3 | 4} />
          )}
        </div>

        <h3 class="font-display text-lg font-medium text-ink">{project.title[lang]}</h3>
        <p class="mt-2 text-sm text-ink-soft">{project.oneLiner[lang]}</p>

        <p class="mt-3 flex-1 font-mono text-[10px] uppercase tracking-wide text-sage-darker">
          {project.visibility === 'client' ? t('work.badge.client') : t('work.badge.personal')}
        </p>

        <button
          type="button"
          class="card-flip-trigger mt-6 inline-flex items-center gap-2 self-start border-b border-terracotta-deep pb-0.5 font-mono text-xs uppercase tracking-wide text-terracotta-deep transition-colors duration-200 hover:text-terracotta"
          aria-expanded="false"
        >
          {t('work.card.open')} <span aria-hidden="true">↻</span>
        </button>
      </div>

      <!-- BACK -->
      <div
        class="card-face absolute inset-0 flex flex-col overflow-y-auto rounded-lg border border-line-strong bg-ink p-6 text-cream shadow-[6px_6px_0_0_var(--color-line-strong)]"
        style="backface-visibility: hidden; transform: rotateY(180deg);"
        data-face="back"
        inert
      >
        <div class="flex items-start justify-between">
          <h3 class="font-display text-lg font-medium">{project.title[lang]}</h3>
          <span class="font-mono text-[11px] uppercase tracking-widest text-terracotta-light">{project.year}</span>
        </div>

        <dl class="mt-4 space-y-3 text-xs leading-relaxed">
          <div>
            <dt class="font-mono uppercase tracking-wide text-cream/60">{t('work.field.problem')}</dt>
            <dd class="mt-1 text-cream/90">{project.problem[lang]}</dd>
          </div>
          <div>
            <dt class="font-mono uppercase tracking-wide text-cream/60">{t('work.field.highlights')}</dt>
            <dd class="mt-1.5 space-y-1.5 text-cream/90">
              {project.highlights.map((h) => (
                <p class="flex gap-2">
                  <span class="text-terracotta-light" aria-hidden="true">—</span>
                  <span>{h[lang]}</span>
                </p>
              ))}
            </dd>
          </div>
          <div>
            <dt class="font-mono uppercase tracking-wide text-cream/60">{t('work.field.stack')}</dt>
            <dd class="mt-1 flex flex-wrap gap-1.5">
              {project.stack.map((s) => (
                <span class="rounded-full border border-cream/25 px-2 py-0.5 text-[10px]">{s}</span>
              ))}
            </dd>
          </div>
          <div>
            <dt class="font-mono uppercase tracking-wide text-cream/60">{t('work.field.result')}</dt>
            <dd class="mt-1 text-cream/90">{project.result[lang]}</dd>
          </div>
        </dl>

        <div class="mt-auto flex items-center justify-between gap-4 pt-6">
          <a
            href={detailHref}
            class="inline-flex items-center gap-2 rounded-full bg-terracotta-light px-4 py-2 font-mono text-[11px] uppercase tracking-wide text-ink transition-colors duration-200 hover:bg-cream"
          >
            {t('work.card.dossier')} <span aria-hidden="true">→</span>
          </a>
          <button
            type="button"
            class="card-flip-trigger inline-flex items-center gap-1 font-mono text-[11px] uppercase tracking-wide text-cream/60 transition-colors duration-200 hover:text-cream"
            aria-expanded="true"
          >
            <span aria-hidden="true">↺</span> {t('work.card.close')}
          </button>
        </div>
      </div>
    </div>
  </div>
</article>

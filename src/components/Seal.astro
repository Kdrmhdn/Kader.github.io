---
// Abstract "workshop stamp" mark — replaces a project photo. Four hand-set
// geometric compositions, no image asset, no AI-cliché iconography.
interface Props {
  n: 1 | 2 | 3 | 4;
  class?: string;
}
const { n, class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 200 200"
  class={`h-full w-full ${className}`}
  aria-hidden="true"
  role="presentation"
>
  {n === 1 && (
    <g fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="100" cy="100" r="72" />
      <circle cx="100" cy="100" r="52" stroke-dasharray="2 6" />
      <path d="M100 28 L100 172 M28 100 L172 100" stroke-width="1" opacity="0.5" />
      <circle cx="100" cy="100" r="8" fill="currentColor" stroke="none" />
    </g>
  )}
  {n === 2 && (
    <g fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="40" y="40" width="120" height="120" />
      <rect x="60" y="60" width="80" height="80" stroke-dasharray="2 5" />
      <path d="M40 40 L160 160 M160 40 L40 160" stroke-width="1" opacity="0.4" />
    </g>
  )}
  {n === 3 && (
    <g fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M100 24 L172 146 L28 146 Z" />
      <path d="M100 64 L140 132 L60 132 Z" stroke-dasharray="2 5" />
      <circle cx="100" cy="112" r="4" fill="currentColor" stroke="none" />
    </g>
  )}
  {n === 4 && (
    <g fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M30 100 Q100 30 170 100 Q100 170 30 100 Z" />
      <circle cx="100" cy="100" r="30" stroke-dasharray="2 5" />
      <path d="M100 70 L100 130 M70 100 L130 100" stroke-width="1" opacity="0.5" />
    </g>
  )}
</svg>

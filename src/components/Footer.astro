---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const homeHref = lang === 'fr' ? '/' : '/en/';
---

<footer class="flex flex-wrap items-center justify-between gap-4 border-t border-line px-6 py-8 sm:px-10 lg:px-16">
  <p class="font-mono text-[11px] uppercase tracking-wide text-ink-soft">
    © {year} — {t('footer.rights')}
  </p>
  <a
    href={`${homeHref}#hero`}
    class="font-mono text-[11px] uppercase tracking-wide text-ink-soft transition-colors duration-200 hover:text-terracotta-deep"
  >
    {t('footer.back')} ↑
  </a>
</footer>

---
import { now } from '../data/now';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="now" class="relative border-t border-line px-6 py-20 sm:px-10 lg:px-16">
  <div class="flex flex-wrap items-start justify-between gap-x-12 gap-y-8">
    <div class="reveal max-w-xs">
      <p class="mb-4 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-terracotta-deep">
        <span class="h-px w-8 bg-terracotta" aria-hidden="true"></span>
        {t('now.kicker')}
      </p>
      <h2 class="font-display text-lg leading-tight font-medium text-ink">{t('now.title')}</h2>
      <p class="mt-3 text-sm text-ink-soft">{t('now.intro')}</p>
    </div>

    <ul class="reveal-group flex max-w-xl flex-1 flex-wrap gap-3">
      {now.map((item) => (
        <li class="reveal-item rounded-full border border-line-strong px-4 py-2 text-sm text-ink-soft">
          {item.label[lang]}
        </li>
      ))}
    </ul>
  </div>
</section>
